-    await this.prisma.user.create({ data: { email, passwordHash } });
+    return this.prisma.organization.create({
+      data: {
+        name: `${email.split('@')[0]}'s Organization`,
+        ownerId: userId,
+        members: {
+          create: { userId, role: 'OWNER', status: 'ACTIVE', joinedAt: new Date() },
+        },
+      },
