# Reuse existing PostgreSQL instance (e.g. on "kuring") — new DB/schema for this app
DATABASE_URL="postgresql://user:password@kuring:5432/ai_software_factory?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Single admin user, seeded on first boot if not present
ADMIN_EMAIL="nanjar@nanjarbudiman.com"
ADMIN_PASSWORD="change-me"

# n8n
N8N_START_WEBHOOK_URL="https://theworkflow.nanjarbudiman.com/webhook/ai-software-factory/start"

# Shared secret n8n must send in the "X-Webhook-Secret" header when calling
# this backend's /webhooks/n8n/* endpoints. Set the same value on the n8n side.
N8N_WEBHOOK_SECRET="change-me-too"

PORT=4000

# ===== V1.1 =====

# Google OAuth (Section 4.1 PRD V1.1). Authorized redirect URI di Google Cloud Console
# harus SAMA PERSIS dengan GOOGLE_CALLBACK_URL di bawah.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://aisf-api.nanjarbudiman.com/auth/google/callback"

# Dipakai frontend untuk redirect setelah Google login berhasil
FRONTEND_ORIGIN="https://aisf.nanjarbudiman.com"

# i18n default (Section 4.2 PRD V1.1)
DEFAULT_LANGUAGE="id"

# ===== V1.2 =====

# S3-compatible Object Storage (§10 PRD V1.2), consumed by StorageService.
# Biznet Gio NEO Object Storage in production; MinIO is fine for local dev.
STORAGE_PROVIDER="biznet-gio-neo"
STORAGE_ENDPOINT="https://nos.wjv-1.neo.id"
STORAGE_REGION="wjv-1"
STORAGE_BUCKET="aisf-artifacts"
STORAGE_ACCESS_KEY="change-me"
STORAGE_SECRET_KEY="change-me-too"
