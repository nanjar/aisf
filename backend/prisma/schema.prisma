generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  RUNNING
  COMPLETED
  REJECTED
  FAILED
}

// V1.2: additive only — GENERATED keeps its existing meaning ("ready for a
// human decision") so StagesService.decide()'s existing gate on GENERATED
// doesn't need to change. New states slot in around it for the reliable
// generation pipeline (§11 PRD V1.2) and the revision workflow (§9).
enum StageStatus {
  PENDING
  GENERATING        // NEW — file/section-by-file generation in progress
  VALIDATING        // NEW — running sandboxed validation
  SELF_HEALING      // NEW — automatic retry after a failed validation
  GENERATED
  REVISION_REQUESTED // NEW — sent back for changes, not archived
  APPROVED
  REJECTED
  ARCHIVED           // NEW — terminal state after REJECTED, distinct so
                      // REJECTED can stay meaningful as "the decision", while
                      // ARCHIVED means "and now closed out"
}

enum StageKey {
  PRD
  ARCHITECTURE
  UIUX // V1.3 §8 — sisip antara Architecture dan Estimation
  ESTIMATION
  DATABASE
  BACKEND
  FRONTEND
  QA
  PACKAGE
}

// V1.1: cara user login. Google user tidak selalu punya passwordHash.
enum AuthProvider {
  LOCAL
  GOOGLE
}

// V1.2: role level organisasi (§7 PRD V1.2)
enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MemberStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum ValidationStatus {
  PENDING
  PASSED
  FAILED
}

enum ReminderType {
  T_MINUS_24H
  T_MINUS_3H
  OVERDUE
}

// V1.3 §29: nama provider LLM yang didukung LLMModule. Menambah provider baru
// (mis. Qwen) = tambah value di sini + implementasikan LLMProvider interface,
// TIDAK butuh migration lain di luar ini.
enum LLMProviderName {
  DEEPSEEK
  OPENAI_COMPATIBLE
  QWEN
}

// V1.3 §54 (project/job-level generation state)
enum GenerationJobStatus {
  PLANNED
  RUNNING
  VALIDATING
  BUILDING
  COMPLETED
  FAILED
}

// V1.3 §54 (file-level generation state) — dipakai juga sebagai resultStatus
// di RepairAttempt (§67 repair history mencatat status akhir repair).
enum GenerationFileStatus {
  PLANNED
  GENERATING
  GENERATED
  VALIDATING
  VALID
  INVALID
  REPAIRING
  FAILED
}

// V1.3 §33: empat level validasi.
enum ValidationLevel {
  FILE
  PROJECT
  COMPILE
  BUILD
}

// V1.3 §26/§27: status merge chunk untuk file besar.
enum ChunkStatus {
  PENDING
  RECEIVED
  MERGED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  // V1.1: nullable — user yang login lewat Google tidak punya password lokal
  passwordHash String?      @map("password_hash")
  // V1.1: nama tampilan, diisi dari profil Google (atau null untuk user lokal lama)
  name         String?
  // V1.1: id akun Google, unik jika terisi
  googleId     String?      @unique @map("google_id")
  authProvider AuthProvider @default(LOCAL) @map("auth_provider")
  // BUGFIX bahasa V1.1: kolom ini sebelumnya tidak pernah dibuat meski sudah
  // disebut di Dokumentasi V1.1 §5.1. Switching langsung di UI TIDAK
  // bergantung pada kolom ini (itu localStorage, lihat frontend/src/lib/i18n)
  // — ini hanya untuk preferensi lintas-device/re-login.
  preferredLanguage String  @default("id") @map("preferred_language")
  createdAt    DateTime     @default(now()) @map("created_at")

  // V1.2
  ownedOrganizations  Organization[]        @relation("OrgOwner")
  memberships         OrganizationMember[]
  createdProjects     Project[]             @relation("ProjectCreatedBy")
  decidedStages       ArtifactStage[]       @relation("StageDecidedBy")

  @@map("users")
}

// ---------------------------------------------------------------
// V1.2 — Organization, Team, Membership (§6 PRD V1.2)
// ---------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  ownerId   String   @map("owner_id")
  owner     User     @relation("OrgOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teams    Team[]
  members  OrganizationMember[]
  projects Project[]

  @@map("organizations")
}

model Team {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")

  members TeamMember[]
  stageAssignments StageAssignment[]

  @@index([organizationId])
  @@map("teams")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           OrgRole      @default(MEMBER)
  status         MemberStatus @default(INVITED)
  invitedBy      String?      @map("invited_by")
  invitedAt      DateTime     @default(now()) @map("invited_at")
  joinedAt       DateTime?    @map("joined_at")
  inviteToken           String?   @unique @map("invite_token")
  inviteTokenExpiresAt  DateTime? @map("invite_token_expires_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamMemberships  TeamMember[]
  stageAssignments StageAssignment[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("organization_members")
}

model TeamMember {
  id                   String   @id @default(uuid())
  teamId               String   @map("team_id")
  organizationMemberId String   @map("organization_member_id")
  jobTitle             String?  @map("job_title") // mis. "Backend Lead", "QA Lead"
  createdAt            DateTime @default(now()) @map("created_at")

  team   Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@unique([teamId, organizationMemberId])
  @@index([teamId])
  @@map("team_members")
}

// ---------------------------------------------------------------
// Project & Pipeline (existing model, extended for V1.2)
// ---------------------------------------------------------------

model Project {
  id              String        @id @default(uuid())
  name            String
  businessIdea    String        @map("business_idea")
  knowledgeBaseId String?       @map("knowledge_base_id")
  aiModel         String        @default("gpt-5-mini") @map("ai_model")
  status          ProjectStatus @default(RUNNING)
  n8nExecutionId  String?       @map("n8n_execution_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // V1.2 — nullable for now to avoid breaking any existing project rows;
  // see migration note in README-v1.2-patch.md before enforcing NOT NULL.
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdById    String?       @map("created_by_id")
  createdBy      User?         @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  // S3 folder root is users/{createdById}/projects/{id}/... — see StorageService.
  deadlineAt     DateTime?     @map("deadline_at")

  stages           ArtifactStage[]
  stageAssignments StageAssignment[]

  @@index([organizationId])
  @@index([createdById])
  @@map("projects")
}

model ArtifactStage {
  id           String      @id @default(uuid())
  projectId    String      @map("project_id")
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageKey     StageKey    @map("stage_key")
  artifactName String?     @map("artifact_name")
  // DEPRECATED as the primary payload once ArtifactObject/S3 is wired up
  // (this batch adds the column below but the storage module itself is a
  // follow-up patch) — kept NOT removed so existing rows stay readable.
  content      String?
  status       StageStatus @default(PENDING)
  resumeUrl    String?     @map("resume_url")
  comment      String?
  decidedBy    String?     @map("decided_by") // legacy: free-text email, kept for backward compat
  decidedById  String?     @map("decided_by_id") // V1.2: proper FK once caller passes a userId
  decidedByUser User?      @relation("StageDecidedBy", fields: [decidedById], references: [id])
  generatedAt  DateTime?   @map("generated_at")
  decidedAt    DateTime?   @map("decided_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // V1.2 — governance (§7, §8 PRD V1.2)
  deadlineAt            DateTime? @map("deadline_at")
  overdueAt             DateTime? @map("overdue_at")
  revisionCount         Int       @default(0) @map("revision_count")
  // V1.2 — reliable generation (§11 PRD V1.2)
  validationStatus      ValidationStatus @default(PENDING) @map("validation_status")
  selfHealingAttempts   Int              @default(0) @map("self_healing_attempts")
  failedValidation      Boolean          @default(false) @map("failed_validation")

  revisions RevisionRequest[]
  artifacts ArtifactObject[]
  reminders ReminderLog[]
  generationJobs GenerationJob[] // V1.3

  @@unique([projectId, stageKey])
  @@index([projectId])
  @@map("artifact_stages")
}

// ---------------------------------------------------------------
// V1.2 — Stage Assignment & Revision (§7, §9 PRD V1.2)
// ---------------------------------------------------------------

model StageAssignment {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  stageKey         StageKey @map("stage_key")
  // V1.2 (team assignment): salah satu dari dua ini terisi, tidak keduanya/kosong
  // (ditegakkan di StagesService, plus CHECK constraint di database).
  assignedMemberId String?  @map("assigned_member_id")
  assignedTeamId   String?  @map("assigned_team_id")
  assignedBy       String   @map("assigned_by")
  assignedAt       DateTime @default(now()) @map("assigned_at")

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedMember OrganizationMember? @relation(fields: [assignedMemberId], references: [id])
  assignedTeam   Team?               @relation(fields: [assignedTeamId], references: [id])

  @@unique([projectId, stageKey])
  @@index([assignedMemberId])
  @@index([assignedTeamId])
  @@map("stage_assignments")
}

model RevisionRequest {
  id              String    @id @default(uuid())
  artifactStageId String    @map("artifact_stage_id")
  comment         String
  requestedBy     String    @map("requested_by")
  requestedAt     DateTime  @default(now()) @map("requested_at")
  revisionNumber  Int       @map("revision_number")
  resolvedAt      DateTime? @map("resolved_at")

  artifactStage ArtifactStage @relation(fields: [artifactStageId], references: [id], onDelete: Cascade)

  @@index([artifactStageId])
  @@map("revision_requests")
}

// ---------------------------------------------------------------
// V1.2 — Object Storage Metadata (§10 PRD V1.2)
// Storage module itself (S3 client) is a separate follow-up patch — this
// table exists now so ArtifactStage relations are already in place.
// ---------------------------------------------------------------

model ArtifactObject {
  id              String   @id @default(uuid())
  artifactStageId String   @map("artifact_stage_id")
  fileName        String   @map("file_name") // e.g. "src/main.ts" or "PRD.md"
  storageProvider String   @map("storage_provider") // "minio" | "s3" | "r2" | "wasabi"
  bucket          String
  objectKey       String   @map("object_key")
  size            Int
  mimeType        String   @map("mime_type")
  checksum        String   // sha256 hex
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")

  artifactStage ArtifactStage @relation(fields: [artifactStageId], references: [id], onDelete: Cascade)
  generationFile GenerationFile? // V1.3 — set once this object is the persisted output of a GenerationFile

  @@index([artifactStageId])
  @@index([artifactStageId, fileName, version])
  @@map("artifact_objects")
}

// ---------------------------------------------------------------
// V1.2 — Deadline Reminder (§5 PRD V1.2)
// ---------------------------------------------------------------

model ReminderLog {
  id              String       @id @default(uuid())
  artifactStageId String       @map("artifact_stage_id")
  reminderType    ReminderType @map("reminder_type")
  sentTo          String       @map("sent_to")
  sentAt          DateTime     @default(now()) @map("sent_at")

  artifactStage ArtifactStage @relation(fields: [artifactStageId], references: [id], onDelete: Cascade)

  @@unique([artifactStageId, reminderType])
  @@map("reminder_logs")
}

// ---------------------------------------------------------------
// V1.3 — Generation Engine data model (§69, §70 PRD V1.3)
// Fase 1: model saja + LLMModule. Orkestrasi file-by-file generation yang
// benar-benar mengisi tabel-tabel ini adalah Fase 3 (Manifest + engine).
// ---------------------------------------------------------------

model GenerationJob {
  id              String   @id @default(uuid())
  artifactStageId String   @map("artifact_stage_id")
  artifactStage   ArtifactStage @relation(fields: [artifactStageId], references: [id], onDelete: Cascade)

  provider      LLMProviderName @default(DEEPSEEK)
  model         String
  promptVersion String          @map("prompt_version") // §79, mis. "backend-file-generator-v1"

  status      GenerationJobStatus @default(PLANNED)
  attempt     Int                 @default(1)
  maxAttempts Int                 @default(3) @map("max_attempts") // §36 — retry tidak boleh infinite

  totalFiles     Int @default(0) @map("total_files")
  generatedFiles Int @default(0) @map("generated_files")
  missingFiles   Int @default(0) @map("missing_files")
  invalidFiles   Int @default(0) @map("invalid_files")

  // §78 — cost control / observability, BUKAN billing customer
  inputTokens      Int      @default(0) @map("input_tokens")
  outputTokens     Int      @default(0) @map("output_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  estimatedCostUsd Decimal? @map("estimated_cost_usd") @db.Decimal(10, 4)

  // §75 — kategori kegagalan: LLM_ERROR | LLM_TIMEOUT | OUTPUT_INCOMPLETE |
  // FILE_VALIDATION_FAILED | PROJECT_VALIDATION_FAILED | COMPILE_FAILED |
  // BUILD_FAILED | STORAGE_FAILED | MANIFEST_INCOMPLETE | RETRY_EXHAUSTED
  errorCategory String? @map("error_category")
  errorMessage  String? @map("error_message")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  files             GenerationFile[]
  validationResults ValidationResult[]

  @@index([artifactStageId])
  @@map("generation_jobs")
}

model GenerationFile {
  id              String        @id @default(uuid())
  generationJobId String        @map("generation_job_id")
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  path        String // path relatif project root, mis. "src/main.ts"
  status      GenerationFileStatus @default(PLANNED)
  attempt     Int                  @default(1)
  maxAttempts Int                  @default(3) @map("max_attempts")

  // §25 dependency graph — daftar path file lain yang harus GENERATED lebih
  // dulu. Disimpan sebagai path list dulu (bukan tabel edge terpisah) supaya
  // Fase 1 tetap ringan; bisa dinormalisasi di fase generation engine kalau
  // ternyata perlu query graph yang lebih kompleks.
  dependsOnPaths String[] @map("depends_on_paths")

  // Terisi begitu file GENERATED dan berhasil di-upload (lihat StorageService).
  artifactObjectId String?         @unique @map("artifact_object_id")
  artifactObject    ArtifactObject? @relation(fields: [artifactObjectId], references: [id])

  checksum     String?
  errorMessage String? @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chunks            GenerationChunk[]
  validationResults ValidationResult[]
  repairAttempts    RepairAttempt[]

  @@unique([generationJobId, path])
  @@index([generationJobId])
  @@map("generation_files")
}

model GenerationChunk {
  id               String         @id @default(uuid())
  generationFileId String         @map("generation_file_id")
  generationFile   GenerationFile @relation(fields: [generationFileId], references: [id], onDelete: Cascade)

  sequence    Int
  totalChunks Int @map("total_chunks")

  // Isi chunk mentah. Dibaca ulang saat merge (§26); tidak dihapus otomatis
  // supaya §27 (deteksi chunk hilang/duplikat) bisa diaudit ulang kalau perlu.
  content  String
  checksum String
  status   ChunkStatus @default(RECEIVED)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([generationFileId, sequence])
  @@index([generationFileId])
  @@map("generation_chunks")
}

model ValidationResult {
  id              String        @id @default(uuid())
  generationJobId String        @map("generation_job_id")
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  // Null untuk level PROJECT/COMPILE/BUILD (berlaku ke seluruh job, bukan 1 file).
  generationFileId String?         @map("generation_file_id")
  generationFile    GenerationFile? @relation(fields: [generationFileId], references: [id], onDelete: Cascade)

  level      ValidationLevel
  passed     Boolean
  errors     Json? // list error terstruktur; null kalau passed
  durationMs Int?  @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([generationJobId])
  @@index([generationFileId])
  @@map("validation_results")
}

model RepairAttempt {
  id                  String         @id @default(uuid())
  generationFileId    String         @map("generation_file_id")
  generationFile      GenerationFile @relation(fields: [generationFileId], references: [id], onDelete: Cascade)

  attemptNumber       Int    @map("attempt_number")
  errorSummary        String @map("error_summary")
  repairPromptVersion String @map("repair_prompt_version") // §79, mis. "backend-repair-v1"
  resultStatus        GenerationFileStatus @map("result_status")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([generationFileId])
  @@map("repair_attempts")
}
