generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  RUNNING
  COMPLETED
  REJECTED
  FAILED
}

// V1.2: additive only — GENERATED keeps its existing meaning ("ready for a
// human decision") so StagesService.decide()'s existing gate on GENERATED
// doesn't need to change. New states slot in around it for the reliable
// generation pipeline (§11 PRD V1.2) and the revision workflow (§9).
enum StageStatus {
  PENDING
  GENERATING        // NEW — file/section-by-file generation in progress
  VALIDATING        // NEW — running sandboxed validation
  SELF_HEALING      // NEW — automatic retry after a failed validation
  GENERATED
  REVISION_REQUESTED // NEW — sent back for changes, not archived
  APPROVED
  REJECTED
  ARCHIVED           // NEW — terminal state after REJECTED, distinct so
                      // REJECTED can stay meaningful as "the decision", while
                      // ARCHIVED means "and now closed out"
}

enum StageKey {
  PRD
  ARCHITECTURE
  ESTIMATION
  DATABASE
  BACKEND
  FRONTEND
  QA
  PACKAGE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MemberStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum ValidationStatus {
  PENDING
  PASSED
  FAILED
}

enum ReminderType {
  T_MINUS_24H
  T_MINUS_3H
  OVERDUE
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String?      @map("password_hash")
  name         String?
  googleId     String?      @unique @map("google_id")
  authProvider AuthProvider @default(LOCAL) @map("auth_provider")
  preferredLanguage String  @default("id") @map("preferred_language")
  createdAt    DateTime     @default(now()) @map("created_at")

  ownedOrganizations  Organization[]        @relation("OrgOwner")
  memberships         OrganizationMember[]
  createdProjects     Project[]             @relation("ProjectCreatedBy")
  decidedStages       ArtifactStage[]       @relation("StageDecidedBy")

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  ownerId   String   @map("owner_id")
  owner     User     @relation("OrgOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teams    Team[]
  members  OrganizationMember[]
  projects Project[]

  @@map("organizations")
}

model Team {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")

  members TeamMember[]
  stageAssignments StageAssignment[]

  @@index([organizationId])
  @@map("teams")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           OrgRole      @default(MEMBER)
  status         MemberStatus @default(INVITED)
  invitedBy      String?      @map("invited_by")
  invitedAt      DateTime     @default(now()) @map("invited_at")
  joinedAt       DateTime?    @map("joined_at")
  inviteToken           String?   @unique @map("invite_token")
  inviteTokenExpiresAt  DateTime? @map("invite_token_expires_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamMemberships  TeamMember[]
  stageAssignments StageAssignment[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("organization_members")
}

model TeamMember {
  id                   String   @id @default(uuid())
  teamId               String   @map("team_id")
  organizationMemberId String   @map("organization_member_id")
  jobTitle             String?  @map("job_title")
  createdAt            DateTime @default(now()) @map("created_at")

  team   Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@unique([teamId, organizationMemberId])
  @@index([teamId])
  @@map("team_members")
}

model Project {
  id              String        @id @default(uuid())
  name            String
  businessIdea    String        @map("business_idea")
  knowledgeBaseId String?       @map("knowledge_base_id")
  aiModel         String        @default("gpt-5-mini") @map("ai_model")
  status          ProjectStatus @default(RUNNING)
  n8nExecutionId  String?       @map("n8n_execution_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdById    String?       @map("created_by_id")
  createdBy      User?         @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  deadlineAt     DateTime?     @map("deadline_at")

  stages           ArtifactStage[]
  stageAssignments StageAssignment[]

  @@index([organizationId])
  @@index([createdById])
  @@map("projects")
}

model ArtifactStage {
  id           String      @id @default(uuid())
  projectId    String      @map("project_id")
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageKey     StageKey    @map("stage_key")
  artifactName String?     @map("artifact_name")
  content      String?
  status       StageStatus @default(PENDING)
  resumeUrl    String?     @map("resume_url")
  comment      String?
  decidedBy    String?     @map("decided_by")
  decidedById  String?     @map("decided_by_id")
  decidedByUser User?      @relation("StageDecidedBy", fields: [decidedById], references: [id])
  generatedAt  DateTime?   @map("generated_at")
  decidedAt    DateTime?   @map("decided_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  deadlineAt            DateTime? @map("deadline_at")
  overdueAt             DateTime? @map("overdue_at")
  revisionCount         Int       @default(0) @map("revision_count")
  validationStatus      ValidationStatus @default(PENDING) @map("validation_status")
  selfHealingAttempts   Int              @default(0) @map("self_healing_attempts")
  failedValidation      Boolean          @default(false) @map("failed_validation")

  revisions RevisionRequest[]
  artifacts ArtifactObject[]
  reminders ReminderLog[]

  @@unique([projectId, stageKey])
  @@index([projectId])
  @@map("artifact_stages")
}

model StageAssignment {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  stageKey         StageKey @map("stage_key")
  assignedMemberId String?  @map("assigned_member_id")
  assignedTeamId   String?  @map("assigned_team_id")
  assignedBy       String   @map("assigned_by")
  assignedAt       DateTime @default(now()) @map("assigned_at")

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedMember OrganizationMember? @relation(fields: [assignedMemberId], references: [id])
  assignedTeam   Team?               @relation(fields: [assignedTeamId], references: [id])

  @@unique([projectId, stageKey])
  @@index([assignedMemberId])
  @@index([assignedTeamId])
  @@map("stage_assignments")
}

model RevisionRequest {
  id              String    @id @default(uuid())
  artifactStageId String    @map("artifact_stage_id")
  comment         String
  requestedBy     String    @map("requested_by")
  requestedAt     DateTime  @default(now()) @map("requested_at")
  revisionNumber  Int       @map("revision_number")
  resolvedAt      DateTime? @map("resolved_at")

  artifactStage ArtifactStage @relation(fields: [artifactStageId], references: [id], onDelete: Cascade)

  @@index([artifactStageId])
  @@map("revision_requests")
}

model ArtifactObject {
  id              String   @id @default(uuid())
  artifactStageId String   @map("artifact_stage_id")
  fileName        String   @map("file_name")
  storageProvider String   @map("storage_provider")
  bucket          String
  objectKey       String   @unique @map("object_key")
  size            Int
  mimeType        String   @map("mime_type")
  checksum        String
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")

  artifactStage ArtifactStage @relation(fields: [artifactStageId], references: [id], onDelete: Cascade)

  @@index([artifactStageId])
  @@index([artifactStageId, fileName, version])
  @@map("artifact_objects")
}

model ReminderLog {
  id              String       @id @default(uuid())
  artifactStageId String       @map("artifact_stage_id")
  reminderType    ReminderType @map("reminder_type")
  sentTo          String       @map("sent_to")
  sentAt          DateTime     @default(now()) @map("sent_at")

  artifactStage ArtifactStage @relation(fields: [artifactStageId], references: [id], onDelete: Cascade)

  @@unique([artifactStageId, reminderType])
  @@map("reminder_logs")
}
