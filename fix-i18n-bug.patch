@@ -85,4 +85,19 @@ export class AuthService implements OnModuleInit {
       },
     });
   }
+
+  /**
+   * BUGFIX (bahasa tidak konsisten): persist preferensi bahasa user supaya
+   * konsisten lintas-device/re-login. Switching langsung di UI TIDAK
+   * menunggu call ini — lihat frontend/src/lib/i18n/I18nProvider.tsx, yang
+   * menerapkan bahasa dari localStorage dulu lalu memanggil ini secara
+   * fire-and-forget.
+   */
+  async updatePreferredLanguage(userId: string, lang: 'id' | 'en') {
+    return this.prisma.user.update({
